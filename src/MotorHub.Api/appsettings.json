{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Empty values are intentional: they document the required keys while guaranteeing a
  // startup failure in any environment that does not override them. Supply real values via
  // user secrets (Development) or environment variables using the double-underscore
  // separator, e.g. JwtSettings__Secret / ConnectionStrings__DefaultConnection.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "MotorHub",
    "Audience": "MotorHubUsers",
    "ExpiryMinutes": 60
  }

  // "Database": { "AutoMigrateOnStartup": true } applies pending migrations at startup.
  // Deliberately unset here so the code default applies: on in Development, off elsewhere.
  // Setting it in this file would override that default in every environment.
}
